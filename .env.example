# CaseClosed runtime configuration. Copy to .env.local and fill in values.
# Never commit real secrets.

# --- Foundation (used now) -------------------------------------------------
# SQLite database shared by the API and the worker. Relative paths resolve
# against the repository root.
DATABASE_PATH=var/caseclosed.sqlite
ARTIFACT_DIR=var/artifacts
LOCK_DIR=var/locks
PUBLIC_BASE_URL=http://localhost:3000

# Controlled staging app (staging/acmecloud).
STAGING_BASE_URL=http://localhost:3001
ENVIRONMENT_ID=staging
# Shared secret for POST /api/test/reset, POST /api/test/session and the
# deployment-ready endpoint. At least 16 characters.
STAGING_TEST_SECRET=replace-with-a-long-random-secret

# Gemini drives ReproSpec generation and semantic reproduction actions.
# Model IDs are recorded only after a credentialed smoke test (M1 gate).
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# --- Later integrations (not implemented by the reproduction subsystem) ----
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BASE_URL=https://slack.com/api
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_BASE_URL=https://api.linear.app/graphql
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_REPOSITORY=acme/acmecloud
GITHUB_DEFAULT_BRANCH=main
GITHUB_BASE_URL=https://api.github.com
